{
  // Minimal — NOT the full Sail model config (see the real one at
  // config/spike/spike-RVI20U32/sail.json for comparison, ~850
  // lines). Only these two fields are ever actually read: ACT4's
  // signature-mode ELF build (.sig.elf, part of `make elfs`
  // unconditionally, regardless of ref_model_exe — see
  // framework/src/act/build_plan.py:_sail_platform_defines) needs
  // them to compile tests/env/sail_macros.h, even though this
  // project's own DUT never talks to Sail at all (ref_model_exe:
  // spike in test_config.yaml — see build_plan.py's own SPIKE branch,
  // which never opens this file). Addresses are placeholders outside
  // this core's real address space (ROM 0x0-0x1FFFF, RAM
  // 0x20000-0x3FFFF) — same values as config/spike/spike-RVI20U32/
  // sail.json's own MMIO/CLINT region, chosen for no other reason
  // than "known not to collide".
  "platform": {
    "clint": {
      "base": 33554432
    },
    "simple_interrupt_generator": {
      "base": 201326592
    }
  }
}
